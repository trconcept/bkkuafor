# MySQL (Hostinger hPanel > Databases > MySQL Databases)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u123456789_kuafor"
DB_USER="u123456789_kuafor"
DB_PASSWORD="CHANGE_ME"

# Set once before the first start. The server hashes it and stores only the
# hash/salt in MySQL; never put this value in the frontend or source control.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD"

# Used by Express when Hostinger is behind its reverse proxy.
NODE_ENV="production"
TRUST_PROXY="true"
PORT="4000"
